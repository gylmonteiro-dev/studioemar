{
  "name": "studioemar",
  "private": true,
  "version": "0.0.0",
  "description": "Sistema de gerenciamento e agendamento do Studio EMAR",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "typecheck:config": "tsc --showConfig -p apps/web/tsconfig.json && tsc --showConfig -p apps/api/tsconfig.json && tsc --showConfig -p packages/shared/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:shared": "pnpm --filter @studioemar/shared build",
    "test:shared": "pnpm --filter @studioemar/shared test",
    "test:api": "pnpm --filter api test",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:api": "pnpm --filter api start:dev",
    "build:api": "pnpm --filter api build",
    "db:up": "docker compose -f infrastructure/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infrastructure/docker-compose.dev.yml down",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:deploy": "pnpm --filter api prisma:deploy",
    "prisma:seed": "pnpm --filter api prisma:seed",
    "prisma:studio": "pnpm --filter api prisma:studio"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.19.0"
  }
}

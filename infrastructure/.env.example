# Copie para infrastructure/.env e troque todos os valores.
# Este arquivo é lido pelo docker-compose.prod.yml. Não versionar o .env.

# Banco (só existe dentro da rede interna do Compose)
POSTGRES_USER=studioemar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=studioemar

# Segredos JWT (ADR-014). Gere cada um com:
#   openssl rand -base64 48
JWT_SECRET=troque-este-segredo-de-access
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh

# Origem do frontend aceita pelo CORS da API.
WEB_ORIGIN=https://studioemar.exemplo.com

# URL pública da API. É embutida no bundle da web durante o build:
# mudar aqui exige `pnpm prod:build` de novo, não só restart.
NEXT_PUBLIC_API_URL=https://api.studioemar.exemplo.com

# Portas publicadas apenas em 127.0.0.1, para o Caddy da VPS fazer o proxy.
WEB_PORT=3000
API_PORT=3001

# Tag das imagens locais.
IMAGE_TAG=latest

# Aplicar `prisma migrate deploy` ao subir a API. Use false para
# atualizar o schema em janela controlada.
RUN_MIGRATIONS=true

# Backup: retenção em dias e destino no host.
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups

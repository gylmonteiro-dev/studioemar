{
  "name": "@studioemar/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tipos e validações compartilhadas do Studio EMAR",
  "main": "./dist-cjs/index.js",
  "types": "./dist-cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      },
      "default": "./src/index.ts"
    },
    "./mocks": {
      "import": {
        "types": "./src/mocks/index.ts",
        "default": "./src/mocks/index.ts"
      },
      "require": {
        "types": "./dist-cjs/mocks/index.d.ts",
        "default": "./dist-cjs/mocks/index.js"
      },
      "default": "./src/mocks/index.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist-cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js dist/**/*.test.js"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "~5.7.3",
    "yaml": "^2.9.0"
  }
}

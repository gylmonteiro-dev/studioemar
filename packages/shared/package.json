{
  "name": "@studioemar/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tipos e validações compartilhadas do Studio EMAR",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mocks": {
      "types": "./src/mocks/index.ts",
      "import": "./src/mocks/index.ts",
      "default": "./src/mocks/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/rules/credit-policy.test.js"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "~5.7.3"
  }
}
